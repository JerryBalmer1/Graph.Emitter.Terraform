*.dll
*.dll.old
*.old
*.zip

# Local .terraform directories
.terraform/

# .tfstate files
*.tfstate
*.tfstate.*

# Crash log files
crash.log
crash.*.log

# Exclude all .tfvars files, which are likely to contain sensitive data, such as
# password, private keys, and other secrets. These should not be part of version 
# control as they are data points which are potentially sensitive and subject 
# to change depending on the environment.
*.tfvars
*.tfvars.json

# Ignore override files as they are usually used to override resources locally and so
# are not checked in
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Ignore transient lock info files created by terraform apply
.terraform.tfstate.lock.info
.terraform.lock.hcl

# Ignore CLI configuration files
.terraformrc
terraform.rc

# Pester output
testResults.xml

# Schema packs built by Invoke-Build BuildSchemaPack (attached to GitHub releases, not committed)
dist/

# Native build outputs in the module's lib folder: TerraformGraph.dll (BuildDLL),
# TerraformGraph.Json.dll (BuildJson) and the TerraformGraph.h that go build generates
# beside the DLL. *.dll and *.dll.old are covered above.
src/TerraformGraph/lib/*.h

# BuildJson intermediates
src/json/bin/
src/json/obj/

# Local build output and secrets
artifacts/
build/
.env
