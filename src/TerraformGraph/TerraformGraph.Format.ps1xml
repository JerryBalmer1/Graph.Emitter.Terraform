<?xml version="1.0" encoding="utf-8"?>
<!-- Table views for typed objects whose default display has more than four properties, which
     PowerShell would otherwise show as a list. Everything else uses DefaultDisplayPropertySet
     from Update-TypeData in TerraformGraph.psm1. -->
<Configuration>
  <ViewDefinitions>
    <View>
      <Name>TerraformGraph.ModuleNode</Name>
      <ViewSelectedBy>
        <TypeName>TerraformGraph.ModuleNode</TypeName>
      </ViewSelectedBy>
      <TableControl>
        <TableHeaders>
          <TableColumnHeader><Label>Id</Label></TableColumnHeader>
          <TableColumnHeader><Label>Kind</Label></TableColumnHeader>
          <TableColumnHeader><Label>SourceKind</Label></TableColumnHeader>
          <TableColumnHeader><Label>Depth</Label></TableColumnHeader>
          <TableColumnHeader><Label>Resolved</Label></TableColumnHeader>
          <TableColumnHeader><Label>Dir</Label></TableColumnHeader>
        </TableHeaders>
        <TableRowEntries>
          <TableRowEntry>
            <TableColumnItems>
              <TableColumnItem><PropertyName>Id</PropertyName></TableColumnItem>
              <TableColumnItem><PropertyName>Kind</PropertyName></TableColumnItem>
              <TableColumnItem><PropertyName>SourceKind</PropertyName></TableColumnItem>
              <TableColumnItem><PropertyName>Depth</PropertyName></TableColumnItem>
              <TableColumnItem><PropertyName>Resolved</PropertyName></TableColumnItem>
              <TableColumnItem><PropertyName>Dir</PropertyName></TableColumnItem>
            </TableColumnItems>
          </TableRowEntry>
        </TableRowEntries>
      </TableControl>
    </View>
    <View>
      <Name>TerraformGraph.ModuleEdge</Name>
      <ViewSelectedBy>
        <TypeName>TerraformGraph.ModuleEdge</TypeName>
      </ViewSelectedBy>
      <TableControl>
        <TableHeaders>
          <TableColumnHeader><Label>From</Label></TableColumnHeader>
          <TableColumnHeader><Label>To</Label></TableColumnHeader>
          <TableColumnHeader><Label>Kind</Label></TableColumnHeader>
          <TableColumnHeader><Label>Call</Label></TableColumnHeader>
          <TableColumnHeader><Label>File</Label></TableColumnHeader>
          <TableColumnHeader><Label>Line</Label></TableColumnHeader>
        </TableHeaders>
        <TableRowEntries>
          <TableRowEntry>
            <TableColumnItems>
              <TableColumnItem><PropertyName>From</PropertyName></TableColumnItem>
              <TableColumnItem><PropertyName>To</PropertyName></TableColumnItem>
              <TableColumnItem><PropertyName>Kind</PropertyName></TableColumnItem>
              <TableColumnItem><PropertyName>Call</PropertyName></TableColumnItem>
              <TableColumnItem><PropertyName>File</PropertyName></TableColumnItem>
              <TableColumnItem><PropertyName>Line</PropertyName></TableColumnItem>
            </TableColumnItems>
          </TableRowEntry>
        </TableRowEntries>
      </TableControl>
    </View>
    <View>
      <Name>TerraformGraph.BundleEntry</Name>
      <ViewSelectedBy>
        <TypeName>TerraformGraph.BundleEntry</TypeName>
      </ViewSelectedBy>
      <TableControl>
        <TableHeaders>
          <TableColumnHeader><Label>ProviderAddress</Label></TableColumnHeader>
          <TableColumnHeader><Label>Version</Label></TableColumnHeader>
          <TableColumnHeader><Label>DocsVersion</Label></TableColumnHeader>
          <TableColumnHeader><Label>SchemaVersion</Label></TableColumnHeader>
          <TableColumnHeader><Label>ClassifierVersion</Label></TableColumnHeader>
          <TableColumnHeader><Label>HarvestedOn</Label></TableColumnHeader>
        </TableHeaders>
        <TableRowEntries>
          <TableRowEntry>
            <TableColumnItems>
              <TableColumnItem><PropertyName>ProviderAddress</PropertyName></TableColumnItem>
              <TableColumnItem><PropertyName>Version</PropertyName></TableColumnItem>
              <TableColumnItem><PropertyName>DocsVersion</PropertyName></TableColumnItem>
              <TableColumnItem><PropertyName>SchemaVersion</PropertyName></TableColumnItem>
              <TableColumnItem><PropertyName>ClassifierVersion</PropertyName></TableColumnItem>
              <TableColumnItem><PropertyName>HarvestedOn</PropertyName></TableColumnItem>
            </TableColumnItems>
          </TableRowEntry>
        </TableRowEntries>
      </TableControl>
    </View>
    <View>
      <Name>TerraformGraph.SubcategorySurveyRow</Name>
      <ViewSelectedBy>
        <TypeName>TerraformGraph.SubcategorySurveyRow</TypeName>
      </ViewSelectedBy>
      <TableControl>
        <TableHeaders>
          <TableColumnHeader><Label>ProviderAddress</Label></TableColumnHeader>
          <TableColumnHeader><Label>Subcategory</Label></TableColumnHeader>
          <TableColumnHeader><Label>ResourceCount</Label></TableColumnHeader>
          <TableColumnHeader><Label>DataSourceCount</Label></TableColumnHeader>
          <TableColumnHeader><Label>Status</Label></TableColumnHeader>
        </TableHeaders>
        <TableRowEntries>
          <TableRowEntry>
            <TableColumnItems>
              <TableColumnItem><PropertyName>ProviderAddress</PropertyName></TableColumnItem>
              <TableColumnItem><PropertyName>Subcategory</PropertyName></TableColumnItem>
              <TableColumnItem><PropertyName>ResourceCount</PropertyName></TableColumnItem>
              <TableColumnItem><PropertyName>DataSourceCount</PropertyName></TableColumnItem>
              <TableColumnItem><PropertyName>Status</PropertyName></TableColumnItem>
            </TableColumnItems>
          </TableRowEntry>
        </TableRowEntries>
      </TableControl>
    </View>
  </ViewDefinitions>
</Configuration>
